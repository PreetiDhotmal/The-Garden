{
  "name": "@the-garden/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:environment-manifest": "node scripts/generateEnvironmentAssetManifest.mjs",
    "predev": "pnpm run generate:environment-manifest",
    "prebuild": "pnpm run generate:environment-manifest",
    "pretypecheck": "pnpm run generate:environment-manifest",
    "pretest": "pnpm run generate:environment-manifest",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "android:sync": "pnpm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "pnpm run build && npx cap sync android && npx cap run android",
    "android:build": "pnpm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/status-bar": "^8.0.3",
    "@dimforge/rapier3d-compat": "0.19.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "@tanstack/react-query": "^5.101.2",
    "@the-garden/shared-types": "workspace:*",
    "framer-motion": "^12.42.2",
    "idb": "^8.0.3",
    "postprocessing": "^6.39.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
