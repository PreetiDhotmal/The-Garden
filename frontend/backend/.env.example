# Active Spring profile: (unset) | dev | prod
# Leave SPRING_PROFILES_ACTIVE unset (or delete this line) to run with NO
# database at all — this is the default during this phase of the project
# (gameplay development, no persistent entities load-bearing yet). Set it to
# "dev" only when you actually want the disk-cache tier backed by a real
# local/dockerized Postgres (e.g. docker-compose up, or your own instance).
# SPRING_PROFILES_ACTIVE=dev

# --- Only used when SPRING_PROFILES_ACTIVE=dev ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=the_garden
DB_USERNAME=the_garden
DB_PASSWORD=the_garden

# --- Production (prod profile — Railway + Neon) ---
# DATABASE_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
# DATABASE_USERNAME=
# DATABASE_PASSWORD=

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- YouVersion Platform (Milestone 6) ---
# REQUIRED. Register an app at https://platform.youversion.com to obtain
# this. The backend fails to start without it (fail-fast validation).
YVP_APP_KEY=

# Optional overrides — sensible defaults are baked in.
# YVP_BASE_URL=https://api.youversion.com
# YVP_DEFAULT_BIBLE_ID=3034
# YVP_CONNECT_TIMEOUT_MILLIS=5000
# YVP_READ_TIMEOUT_MILLIS=8000

# Only needed if you enable "Sign in with YouVersion" (optional user account
# linking — not required to browse/read scripture, which only needs the App
# Key above).
# YVP_OAUTH_REDIRECT_URI=http://localhost:5173/auth/youversion/callback

