# Base URL of the backend API (Spring Boot). No trailing slash.
VITE_API_BASE_URL=http://localhost:8080/api

# Milestone 6: set to "true" to use mock scripture data instead of the real
# backend/YouVersion integration — convenient for local dev without a
# running backend or a configured YVP_APP_KEY. Leave unset (or "false") for
# every real deployment; the game defaults to the real Scripture Platform.
# VITE_USE_MOCK_SCRIPTURE=true
